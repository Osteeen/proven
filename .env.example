# Copy to .env.local and fill in SANDBOX values only. Never commit .env.local.
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Multiparty (platform) - from the Developer Dashboard once partner features are set up
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=
# AI
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://localhost:5432/proven_dev
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3000
DEMO_LOGIN=false

# Market price checks (Channel3). Optional: without it, price checks are skipped.
CHANNEL3_API_KEY=
# Bearer secret for POST /api/jobs/daily (the daily job). Any long random string.
JOB_SECRET=
# Key for fingerprinting recipients' phone numbers (numbers are never stored). Any long random string; required in production.
RECIPIENT_HMAC_KEY=
# The PayPal webhook registered for your public URL (deployed only).
PAYPAL_WEBHOOK_ID=
# The sandbox charity onboarded through Partner Referrals, for the demo.
DEMO_CHARITY_MERCHANT_ID=
DEMO_CHARITY_TRACKING_ID=
# Optional sandbox supplier for the demo (connected through Partner Referrals).
DEMO_SUPPLIER_EMAIL=
DEMO_SUPPLIER_MERCHANT_ID=
DEMO_SUPPLIER_TRACKING_ID=
# Set to 1 to run the database tests against your local database.
RUN_DB_TESTS=
